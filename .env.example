# Provedor de IA: deepseek | openai | mock
# "mock" não usa IA nenhuma (resumo simples por trecho) e serve para testar sem custo.
LLM_PROVIDER=deepseek

# Chave da API do provedor escolhido (nunca commitar o .env real)
LLM_API_KEY=

# Opcional: sobrescrever endereço e modelos
# DeepSeek: https://api.deepseek.com  | modelo barato: deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_CHEAP=deepseek-chat
# Modelo usado só no resumo final do dia (pode ser o mesmo)
LLM_MODEL_BEST=deepseek-chat

# Banco local
RADAR_DB=data/radar.db
